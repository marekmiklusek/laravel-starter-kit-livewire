includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

services:
    -
        class: Tests\PHPStan\Rules\SideEffectCallDetector
        arguments:
            sideEffectClasses: []
    -
        class: Tests\PHPStan\Rules\ArrayInsteadOfDtoRule
        arguments:
            apiResponseNamespaces:
                - App\Services
        tags:
            - phpstan.rules.rule

rules:
    - Tests\PHPStan\Rules\QueryMutationRule
    - Tests\PHPStan\Rules\SideEffectInTransactionRule
    - Tests\PHPStan\Rules\CacheTtlNotCarbonRule

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - tests

    level: max

    tmpDir: tmp/phpstan
